# Copy this file to .env (ignored by git) and fill in the values. Spring Boot reads .env at startup.
# Share the real values with the team through a password manager, never through the repository or a chat.

# Required. Signs the access tokens. Generate it with: openssl rand -base64 48
JWT_SECRET=

# Optional: send real emails through Brevo (the API key is only accepted from authorized IPs)
BREVO_ENABLED=false
BREVO_API_KEY=

# Optional: PostgreSQL instead of the in-memory H2 database
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/viora
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# Individual annual subscription commercial policy
SUBSCRIPTION_MONTHLY_RATE=55
SUBSCRIPTION_TAX_RATE=0.18
SUBSCRIPTION_TARIFF_VERSION=producer-annual-2026-2-igv-included

# Optional: hosted Mercado Pago checkout and signed payment webhooks
# Leave disabled until seller credentials and public HTTPS URLs are configured.
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_SANDBOX=true
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Public HTTPS endpoint ending in /api/v1/payment-notifications/mercado-pago
MERCADO_PAGO_NOTIFICATION_URL=
# Configure after the separate payment-return feature is available.
MERCADO_PAGO_RETURN_URL=
MERCADO_PAGO_CHECKOUT_TTL=PT24H
MERCADO_PAGO_CONNECT_TIMEOUT=PT10S
MERCADO_PAGO_READ_TIMEOUT=PT20S

# Viora assistant: key of Groq (console.groq.com). Blank leaves the assistant answering with its templates.
GROQ_API_KEY=
